# Copy to .env and fill in. Do not commit .env.
#
# EMBEDDING_MODEL chooses the embedder (same model must be used for ingest and search):
#   text-embedding-3-small  — OpenAI; requires LLM_API_KEY
#   gemini-embedding-001    — Google Gemini; requires GEMINI_API_KEY
#   all-MiniLM-L6-v2        — local; no API key; pip install sentence-transformers

LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Folder of markdown/text files to ingest.
DOCS_DIR=docs

# Local vector index written by ingest (gitignored under data/).
INDEX_PATH=data/index.json

# Retrieval defaults for when you implement RAG.
TOP_K=5
TEMPERATURE=0
