# Copy to .env and fill in. Do not commit .env.
#
# EMBEDDING_MODEL chooses the embedder (same model must be used for ingest and search):
#   text-embedding-3-small  — OpenAI; requires LLM_API_KEY
#   gemini-embedding-001    — Google Gemini; requires GEMINI_API_KEY
#   all-MiniLM-L6-v2        — local MiniLM; no API key
#
# LLM_MODEL chooses the chat model for /api/ask:
#   gemini-2.0-flash         — Gemini; requires GEMINI_API_KEY
#   llama3.2                 — Ollama local 3B; requires Ollama running
#   llama-3.1-8b-instant     — Groq; requires GROQ_API_KEY
#   deepseek-v4-flash        — DeepSeek; requires DEEPSEEK_API_KEY

LLM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

# Folder of markdown/text files to ingest.
DOCS_DIR=docs

# Local vector index written by ingest (gitignored under data/).
INDEX_PATH=data/index.json

# Retrieval: search returns this many chunks (same model as ingest).
TOP_K=5
TEMPERATURE=0
