# Copy to .env and fill in. Do not commit .env.
# LLM_API_KEY is required to embed documents during ingest.

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Folder of markdown/text files to ingest.
DOCS_DIR=docs

# Local vector index written by ingest (gitignored under data/).
INDEX_PATH=data/index.json

# Retrieval defaults for when you implement RAG.
TOP_K=5
TEMPERATURE=0
